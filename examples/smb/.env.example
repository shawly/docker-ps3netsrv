# Copy this file to .env. Keep .env private; it contains your SMB password.
# Use single quotes for literal values, especially passwords containing $ or #.
# Values placed in CIFS mount options must not contain commas or line breaks.
SMB_SERVER=192.168.1.20
SMB_SHARE=PS3
SMB_USERNAME=ps3-reader
SMB_PASSWORD='replace-with-your-password'
SMB_DOMAIN=WORKGROUP
SMB_VERSION=3.0

# Container identity. Prefer a dedicated SMB account with read-only share access.
PUID=1000
PGID=1000
TZ=Etc/UTC

# Enter this host port in webMAN, together with the Docker host's LAN address.
PS3NETSRV_HOST_PORT=38008
PS3NETSRV_IMAGE=shawly/ps3netsrv:20260913-alpine3.24
